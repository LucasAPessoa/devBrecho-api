{
    "name": "devbrecho-api-ts",
    "version": "1.0.0",
    "description": "API para o sistema DevBrecho",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup src/server.ts --format esm --out-dir dist --clean",
        "start": "node dist/server.js",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio",
        "prisma:migrate": "npx prisma migrate deploy",
        "seed": "tsx prisma/seed.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "overrides": {
        "lodash": "^4.17.21"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/swagger": "^9.6.1",
        "@fastify/swagger-ui": "^5.2.3",
        "@prisma/adapter-pg": "^7.1.0",
        "@prisma/client": "^7.3.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^17.2.3",
        "fastify": "^5.6.2",
        "fastify-type-provider-zod": "^6.1.0",
        "jsonwebtoken": "^9.0.3",
        "jwt-decode": "^4.0.0",
        "tsx": "^4.20.6",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.9.1",
        "prisma": "^7.3.0",
        "ts-node-dev": "^2.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
